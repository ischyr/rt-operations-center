# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/server/node_modules

# environment
/server/.env
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# Claude Code local settings — never commit (contains personal config)
/.claude/

# WhatsApp sessions — never commit (contains auth credentials)
/server/wa-sessions/

# WhatsApp web.js browser cache — large and machine-specific
/server/.wwebjs_cache/

# BloodHound uploaded ZIPs/JSONs — temp processing files, can be large
/server/uploads/bloodhound/

# Subdomain scan workspaces — contain per-engagement IDs and may hold API keys
/server/subdomains/workspaces/

# Leak & credential uploads — contain sensitive client data, never commit
/server/leaks/

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
