# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ─────────────────────────────────────────────────────────────
/node_modules
/server/node_modules
/.pnp
.pnp.js

# ── Environment / secrets ────────────────────────────────────────────────────
.env
/.env
/server/.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Build / test output ──────────────────────────────────────────────────────
/build
/coverage

# ── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Claude Code local config — never commit (contains personal tokens) ───────
.claude/
/.claude/

# ── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Server runtime data — sensitive / large / machine-specific ───────────────
/server/wa-sessions/
/server/.wwebjs_cache/
/server/uploads/bloodhound/
/server/subdomains/workspaces/
/server/leaks/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.tmp
*.temp
